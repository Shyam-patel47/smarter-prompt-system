// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  email
  google
  github
  phone
}

enum PlanTier {
  free
  pro
}

enum PromptTaskType {
  MARKETING_COPY
  EMAIL
  BLOG_POST
  SOCIAL_MEDIA
  CODE
  RESEARCH_SUMMARY
  CUSTOM
}

enum PromptTone {
  PROFESSIONAL
  CASUAL
  PERSUASIVE
  FRIENDLY
  TECHNICAL
  WITTY
  CUSTOM
}

enum OutputFormat {
  BULLET_POINTS
  PARAGRAPH
  JSON
  TABLE
  STEP_BY_STEP
  CUSTOM
}

enum TargetModel {
  GPT_4O
  CLAUDE
  GEMINI
  OTHER
}

enum ComparisonWinner {
  a
  b
  tie
  none
}

model User {
  id            String       @id @default(uuid())
  email         String?      @unique
  phone         String?      @unique
  passwordHash  String?      @map("password_hash")
  name          String?
  avatarUrl     String?      @map("avatar_url")
  authProvider  AuthProvider @default(email) @map("auth_provider")
  planTier      PlanTier     @default(free) @map("plan_tier")
  isVerified    Boolean      @default(false) @map("is_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  folders         Folder[]
  tags            Tag[]
  prompts         Prompt[]
  comparisons     Comparison[]
  otpTokens       OtpToken[]
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// OTP tokens for email/phone verification & password reset
model OtpToken {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  contact   String   // email or phone
  code      String
  purpose   String   // "signup" | "login" | "reset"
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_tokens")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompts Prompt[]

  @@map("folders")
}

model Tag {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptTags  PromptTag[]

  @@unique([userId, name])
  @@map("tags")
}

model Prompt {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  folderId      String?         @map("folder_id")
  title         String
  taskType      String          @map("task_type")
  detailsInput  String          @db.Text @map("details_input")
  tone          String
  outputFormat  String          @map("output_format")
  targetModel   String?         @map("target_model")
  generatedBody String          @db.Text @map("generated_body")
  isTemplate    Boolean         @default(false) @map("is_template")
  isFavorite    Boolean         @default(false) @map("is_favorite")
  usageCount    Int             @default(0) @map("usage_count")
  deletedAt     DateTime?       @map("deleted_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder           Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  variables        PromptVariable[]
  tags             PromptTag[]
  versions         PromptVersion[]
  comparisonsAsA   Comparison[]     @relation("ComparisonPromptA")
  comparisonsAsB   Comparison[]     @relation("ComparisonPromptB")

  @@map("prompts")
}

model PromptVariable {
  id           String  @id @default(uuid())
  promptId     String  @map("prompt_id")
  key          String
  label        String
  defaultValue String? @map("default_value")
  orderIndex   Int     @default(0) @map("order_index")

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@map("prompt_variables")
}

model PromptTag {
  promptId String @map("prompt_id")
  tagId    String @map("tag_id")

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@map("prompt_tags")
}

model PromptVersion {
  id           String   @id @default(uuid())
  promptId     String   @map("prompt_id")
  bodySnapshot String   @db.Text @map("body_snapshot")
  createdAt    DateTime @default(now()) @map("created_at")

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@map("prompt_versions")
}

model Comparison {
  id                  String           @id @default(uuid())
  userId              String           @map("user_id")
  baseTaskDescription String           @db.Text @map("base_task_description")
  promptAId           String?          @map("prompt_a_id")
  promptABody         String           @db.Text @map("prompt_a_body")
  promptAScore        Int?             @map("prompt_a_score")
  promptBId           String?          @map("prompt_b_id")
  promptBBody         String           @db.Text @map("prompt_b_body")
  promptBScore        Int?             @map("prompt_b_score")
  winner              ComparisonWinner @default(none)
  createdAt           DateTime         @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptA Prompt? @relation("ComparisonPromptA", fields: [promptAId], references: [id], onDelete: SetNull)
  promptB Prompt? @relation("ComparisonPromptB", fields: [promptBId], references: [id], onDelete: SetNull)

  @@map("comparisons")
}
