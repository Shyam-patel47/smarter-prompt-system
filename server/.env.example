MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_super_secret_jwt_key
PORT=5000
CLIENT_URL=https://your-deployed-frontend-url.vercel.app

# Resend — email OTP delivery (get key at https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender in Resend (e.g. otp@yourdomain.com)
OTP_FROM_EMAIL=otp@yourdomain.com

# Frontend URL (for generating reset password links)
FRONTEND_URL=http://localhost:5173
